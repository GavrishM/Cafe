<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cafe</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cafe.styles.css" asp-append-version="true" />
</head>
<body>
    <header>                              @*           фон       *@
        <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom"
             data-bs-theme="light"
             id="mainNavbar">
            <div class="container">
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <a class="navbar-brand" asp-page="/Index">Cafe</a>
                        <li class="navbar-item">
                            <a class="nav-link" asp-page="/Index">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Privacy">Конфиденциальность</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Meals/Index">Блюда</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Clients/Index">Клиенты</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Orders/Index">Заказы</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Workers/Index">Работники</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @*+++ темная тема*@
                        <li class="nav-item">
                            <button class=" navbar btn btn-outline-secondary" onclick="toggleTheme()">🌓 Переключить тему</button>
                        </li>
                        @*--- темная тема*@

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Cafe - <a asp-area="" asp-page="/Privacy">Конфиденциальность</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<script>
    const html = document.documentElement;

    // Проверяем сохраненную тему в localStorage
    const savedTheme = localStorage.getItem('bs-theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const currentTheme = savedTheme || (prefersDark ? 'dark' : 'light');

    html.setAttribute('data-bs-theme', currentTheme);

    // Отслеживаем изменение системной темы (если тема не сохранена)
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', e => {
        if (!localStorage.getItem('bs-theme')) {
            const newTheme = e.matches ? 'dark' : 'light';
            html.setAttribute('data-bs-theme', newTheme);
        }
    });

            function toggleTheme() {
        const html = document.documentElement;
        const navbar = document.querySelector('.navbar');
        const currentTheme = html.getAttribute('data-bs-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';

            // При загрузке
        const savedTheme = localStorage.getItem('bs-theme') || 'light';
        html.setAttribute('data-bs-theme', savedTheme);
        if (navbar) {
            navbar.setAttribute('data-bs-theme', savedTheme);
        }

        // Обновляем тему для всей страницы
        html.setAttribute('data-bs-theme', newTheme);

        // Обновляем тему для navbar
        if (navbar) {
            navbar.setAttribute('data-bs-theme', newTheme);

            // Опционально: меняем классы для светлой/темной темы
            if (newTheme === 'dark') {
                navbar.classList.remove('navbar-light', 'bg-light');
                navbar.classList.add('navbar-dark', 'bg-dark');

            } else {
                navbar.classList.remove('navbar-dark', 'bg-dark');
                navbar.classList.add('navbar-light', 'bg-light');

            }
        }

        // Сохраняем в localStorage
        localStorage.setItem('bs-theme', newTheme);
    }
</script>
