@page
@model Cafe.Pages.Workers.DeleteModel
@{
    ViewData["Title"] = "Удаление работника";
}

<h1>@ViewData["Title"]</h1>

<div class="alert alert-danger">
        <h3>Вы уверены, что хотите удалить этого работника?</h3>
</div>


<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ФИО</dt>
            <dd class="col-sm-9">@Model.Worker.FullName</dd>

            <dt class="col-sm-3">Возвраст</dt>
            <dd class="col-sm-9">@(Model.Worker.Age.ToString() ?? "—")</dd>

            <dt class="col-sm-3">Должность</dt>
            <dd class="col-sm-9">@(Model.Worker.Position ?? "—")</dd>

            <dt class="col-sm-3">Номер телефона</dt>
            <dd class="col-sm-9">@(Model.Worker.Phone ?? "-")</dd>

        </dl>
    </div>
</div>


<form method="post">
    <input type="hidden" asp-for="Worker.Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-page="Index" class="btn btn-secondary">Отмена</a>
</form>