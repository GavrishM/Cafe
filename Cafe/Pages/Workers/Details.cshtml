@page
@model Cafe.Pages.Workers.DetailsModel
@{
	ViewData["Title"] = "Информация о работнике";
}
<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ФИО</dt>
            <dd class="col-sm-9">@Model.Worker.FullName</dd>

            <dt class="col-sm-3">Возвраст</dt>
            <dd class="col-sm-9">@Model.Worker.Age.ToString("C")</dd>

            <dt class="col-sm-3">Должность</dt>
            <dd class="col-sm-9">@(Model.Worker.Position ?? "—")</dd>

            <dt class="col-sm-3">Номер телефона</dt>
            <dd class="col-sm-9">@(Model.Worker.Phone ?? "—")</dd>
        </dl>
    </div>
</div>

<p class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Worker.Id" class="btn btn-warning">Редактировать</a>
    <a asp-page="Delete" asp-route-id="@Model.Worker.Id" class="btn btn-danger">Удалить</a>
    <a asp-page="Index" class="btn btn-secondary">Назад к списку</a>
</p>