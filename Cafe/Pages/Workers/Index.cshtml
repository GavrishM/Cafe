@page
@model Cafe.Pages.Workers.IndexModel
@{
	ViewData["Title"] = "Список работников";
}
<h1>@ViewData["Title"]</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить работника</a>
</p>

<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Возвраст</th>
            <th>Должность</th>
            <th>Телефон</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var worker in Model.WorkersList)
        {
            <tr>
                <td>@worker.FullName</td>
                <td>@worker.Age</td>
                <td>@worker.Position</td>
                <td>@worker.Phone</td>
                <td>
                    <a asp-page="Details" asp-route-id="@worker.Id">Открыть</a>
                </td>
                <td>
                    <a asp-page="Details" asp-route-id="@worker.Id" class="btn btn-sm btn-info">Детали</a>
                    <a asp-page="Edit" asp-route-id="@worker.Id" class="btn btn-sm btn-warning">Редактировать</a>
                    <a asp-page="Delete" asp-route-id="@worker.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>