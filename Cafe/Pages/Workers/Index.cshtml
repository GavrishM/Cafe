@page
@model Cafe.Pages.Workers.IndexModel
@{
	ViewData["Title"] = "Список работников";
}
<h1>@ViewData["Title"]</h1>

<p>На этой странице будет список работников.</p>

<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Возвраст</th>
            <th>Должность</th>
            <th>Телефон</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model.WorkersList)
        {
            <tr>
                <td>@client.FullName</td>
                <td>@client.Age</td>
                <td>@client.Position</td>
                <td>@client.Phone</td>
                <td>
                    <a asp-page="Details" asp-route-id="@client.Id">Открыть</a>
                </td>
            </tr>
        }
    </tbody>
</table>