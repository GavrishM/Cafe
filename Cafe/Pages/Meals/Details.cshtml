@page
@model Cafe.Pages.Meals.DetailsModel
@{
	ViewData["Title"] = "Информация о блюде";
}
<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Название</dt>
            <dd class="col-sm-9">@Model.Meal.Name</dd>

            <dt class="col-sm-3">Категория</dt>
            <dd class="col-sm-9">@(Model.Meal.Type ?? "—")</dd>

            <dt class="col-sm-3">Описание</dt>
            <dd class="col-sm-9">@(Model.Meal.Description ?? "—")</dd>

            <dt class="col-sm-3">Состав</dt>
            <dd class="col-sm-9">@(Model.Meal.Contains ?? "—")</dd>

            <dt class="col-sm-3">Цена</dt>
            <dd class="col-sm-9">@Model.Meal.Price.ToString("C")</dd>

            <dt class="col-sm-3">Цена</dt>
            <dd class="col-sm-9">@Model.Meal.Price.ToString("C")</dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">@(Model.Meal.Status ?? "—")</dd>
        </dl>
    </div>
</div>

<p class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Meal.Id" class="btn btn-warning">Редактировать</a>
    <a asp-page="Delete" asp-route-id="@Model.Meal.Id" class="btn btn-danger">Удалить</a>
    <a asp-page="Index" class="btn btn-secondary">Назад к списку</a>
</p>