@page
@model Cafe.Pages.Objects.Meals.IndexModel
@{
	ViewData["Title"] = "Список блюд";
}
<h1>@ViewData["Title"]</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить блюдо</a>
</p>

<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>Название</th>
            <th>Тип</th>
            <th>Описание</th>
            <th>Состав</th>
            <th>Цена</th>
            <th>Вес</th>
            <th>Статус</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var meal in Model.MealsList)
        {
            <tr>
                <td>@meal.Name</td>
                <td>@meal.Type</td>
                <td>@meal.Description</td>
                <td>@meal.Contains</td>
                <td>@meal.Price</td>
                <td>@meal.Weight</td>
                <td>@meal.Status</td>
                <td>
                    <a asp-page="Details" asp-route-id="@meal.Id">Открыть</a>
                </td>
                <td>
                    <a asp-page="Details" asp-route-id="@meal.Id" class="btn btn-sm btn-info">Детали</a>
                    <a asp-page="Edit" asp-route-id="@meal.Id" class="btn btn-sm btn-warning">Редактировать</a>
                    <a asp-page="Delete" asp-route-id="@meal.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>