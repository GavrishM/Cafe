@page
@model Cafe.Pages.Meals.DeleteModel
@{
    ViewData["Title"] = "Удаление блюда";
}

<h1>@ViewData["Title"]</h1>

<div class="alert alert-danger">
        <h3>Вы уверены, что хотите удалить это блюдо?</h3>
</div>


<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Название</dt>
            <dd class="col-sm-9">@Model.Meal.Name</dd>

            <dt class="col-sm-3">Тип</dt>
            <dd class="col-sm-9">@(Model.Meal.Type ?? "—")</dd>

            <dt class="col-sm-3">Описание</dt>
            <dd class="col-sm-9">@(Model.Meal.Description ?? "—")</dd>

            <dt class="col-sm-3">Состав</dt>
            <dd class="col-sm-9">@(Model.Meal.Contains ?? "—")</dd>

            <dt class="col-sm-3">Цена</dt>
            <dd class="col-sm-9">@(Model.Meal.Price.ToString() ?? "-")</dd>

            <dt class="col-sm-3">Вес</dt>
            <dd class="col-sm-9">@(Model.Meal.Weight.ToString() ?? "-")</dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">@(Model.Meal.Status ?? "—")</dd>

        </dl>
    </div>
</div>


<form method="post">
    <input type="hidden" asp-for="Meal.Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-page="Index" class="btn btn-secondary">Отмена</a>
</form>