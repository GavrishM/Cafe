@page
@model Cafe.Pages.Meals.DeleteModel
@{
    ViewData["Title"] = "Удаление блюда";
}

<h1>@ViewData["Title"]</h1>

<div class="alert alert-danger">
        <h3>Вы уверены, что хотите удалить это блюдо?</h3>
</div>

<div class="card h-100 shadow-sm">
    <div class="card-body">
        <h5 class="card-title">@Model.Meal.Name</h5>
        <p class="card-text">
            <strong>Почта:</strong> @Model.Meal.Type
        </p>
        <p class="card-text">
            <strong>Описание:</strong> @Model.Meal.Description
        </p>
        <p class="card-text">
            <strong>Состав:</strong> @Model.Meal.Contains
        </p>
        <p class="card-text">
            <strong>Цена:</strong> @Model.Meal.Price.ToString()
        </p>
        <p class="card-text">
            <strong>Вес:</strong> @Model.Meal.Weight.ToString()
        </p>
        <p class="card-text">
            <strong>Статус:</strong> @Model.Meal.Status
        </p>
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="Meal.Id" />
    <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
    <a asp-page="Index" class="btn btn-sm btn-outline-secondary">Отмена</a>
</form>