@page
@model Cafe.Pages.Clients.DetailsModel
@{
	ViewData["Title"] = "Информация о клиенте";
}
<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ФИО</dt>
            <dd class="col-sm-9">@Model.Client.FullName</dd>

            <dt class="col-sm-3">Почта</dt>
            <dd class="col-sm-9">@(Model.Client.Email ?? "—")</dd>

            <dt class="col-sm-3">Номер телефона</dt>
            <dd class="col-sm-9">@(Model.Client.Phone ?? "—")</dd>

            <dt class="col-sm-3">Возвраст</dt>
            <dd class="col-sm-9">@Model.Client.Age.ToString("C")</dd>
        </dl>
    </div>
</div>

<p class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Client.Id" class="btn btn-warning">Редактировать</a>
    <a asp-page="Delete" asp-route-id="@Model.Client.Id" class="btn btn-danger">Удалить</a>
    <a asp-page="Index" class="btn btn-secondary">Назад к списку</a>
</p>