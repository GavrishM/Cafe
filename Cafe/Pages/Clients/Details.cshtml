@page
@model Cafe.Pages.Clients.DetailsModel
@{
	ViewData["Title"] = "Информация о клиенте";
}
<h1>@ViewData["Title"]</h1>

<div class="col">
    <div class="card h-100 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">@Model.Client.FullName</h5>
            <p class="card-text">
                <strong>Почта:</strong> @Model.Client.Email
            </p>
            <p class="card-text">
                <strong>Номер телефона:</strong> @Model.Client.Phone
            </p><p class="card-text">
                <strong>Возвраст:</strong> @Model.Client.Age
            </p>
        </div>
        <div class="card-footer bg-transparent">
            <a asp-page="./Edit" asp-route-id="@Model.Client.Id" class="btn btn-sm btn-outline-warning">Редактировать</a>
            <a asp-page="./Delete" asp-route-id="@Model.Client.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
            <a asp-page="./Index" class="btn btn-sm btn-outline-primary">Назад к списку</a>
            @* <a asp-page="Edit" asp-route-id="@Model.Client.Id" class="btn btn-warning">Редактировать</a>
            <a asp-page="Delete" asp-route-id="@Model.Client.Id" class="btn btn-danger">Удалить</a>
            <a asp-page="Index" class="btn btn-secondary">Назад к списку</a> *@
        </div>
    </div>
</div>