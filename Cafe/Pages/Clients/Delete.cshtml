@page
@model Cafe.Pages.Clients.DeleteModel
@{
    ViewData["Title"] = "Удаление клиента";
}

<h1>@ViewData["Title"]</h1>

<div class="alert alert-danger">
        <h3>Вы уверены, что хотите удалить этого клиента?</h3>
</div>


<div class="card h-100 shadow-sm">
    <div class="card-body">
        <h5 class="card-title">@Model.Client.FullName</h5>
        <p class="card-text">
            <strong>Почта:</strong> @Model.Client.Email
        </p>
        <p class="card-text">
            <strong>Номер телефона:</strong> @Model.Client.Phone
        </p><p class="card-text">
            <strong>Возвраст:</strong> @Model.Client.Age
        </p>
    </div>


<form method="post">
    <input type="hidden" asp-for="Client.Id" />
        <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
        <a asp-page="Index" class="btn btn-sm btn-outline-secondary">Отмена</a>
</form>