@page
@model Cafe.Pages.Objects.Clients.IndexModel
@{
	ViewData["Title"] = "Список клиентов";
}
<h1>@ViewData["Title"]</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить клиента</a>
</p>

<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>ФИО</th>
            <th>Почта</th>
            <th>Телефон</th>
            <th>Возвраст</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var client in Model.ClientsList)
        {
            <tr>
                <td>@client.FullName</td>
                <td>@client.Email</td>
                <td>@client.Phone</td>
                <td>@client.Age</td>
                
                <td>
                    <a asp-page="Details" asp-route-id="@client.Id" class="btn btn-sm btn-info">Детали</a>
                    <a asp-page="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-warning">Редактировать</a>
                    <a asp-page="Delete" asp-route-id="@client.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>