@page
@model Cafe.Pages.Objects.Clients.IndexModel
@{
    ViewData["Title"] = "Клиенты";
}
<h1>@ViewData["Title"]</h1>

<p>
    <a asp-page="Create" class="btn btn-sm btn-outline-success">Добавить клиента</a>
</p>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var client in Model.ClientsList)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@client.FullName</h5>
                    <p class="card-text">
                        <strong>Почта:</strong> @client.Email
                    </p>
                    <p class="card-text">
                        <strong>Номер телефона:</strong> @client.Phone
                    </p><p class="card-text">
                        <strong>Возвраст:</strong> @client.Age
                    </p>
                </div>
                <div class="card-footer bg-transparent">
                    <a asp-page="Details" asp-route-id="@client.Id" class="btn btn-sm btn-outline-primary">Детали</a>
                    <a asp-page="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-outline-warning">Редактировать</a>
                    <a asp-page="Delete" asp-route-id="@client.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                </div>
            </div>
        </div>
    }
</div>