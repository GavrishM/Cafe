@page
@model Cafe.Pages.Orders.IndexModel
@{
	ViewData["Title"] = "Список заказов";
}
<h1>@ViewData["Title"]</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить заказ</a>
</p>

<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>Номер заказа</th>
            @*<th>Содержимое заказа</th>*@
            <th>Счет</th>
            <th>Статус</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.OrdersList)
        {
            <tr>
                <td>@order.NumberOrder</td>
                @*<td>@client.Contains</td>*@
                <td>@order.TotalAmount</td>
                <td>@order.Status</td>
                
                <td>
                    <a asp-page="Details" asp-route-id="@order.Id" class="btn btn-sm btn-info">Детали</a>
                    <a asp-page="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-warning">Редактировать</a>
                    <a asp-page="Delete" asp-route-id="@order.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>