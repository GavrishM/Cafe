@page
@model Cafe.Pages.Orders.IndexModel
@{
	ViewData["Title"] = "Список заказов";
}
<h1>@ViewData["Title"]</h1>

<p>
    <a asp-page="Create" class="btn btn-sm btn-outline-success">Добавить заказ</a>
</p>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var order in Model.OrdersList)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@order.NumberOrder</h5>
                    <p class="card-text">
                        <strong>Счет:</strong> @order.TotalAmount
                    </p>
                    <p class="card-text">
                        <strong>Статус:</strong> @order.Status
                    </p>
                </div>
                <div class="card-footer bg-transparent">
                    <a asp-page="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Детали</a>
                    <a asp-page="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-warning">Редактировать</a>
                    <a asp-page="Delete" asp-route-id="@order.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                </div>
            </div>
        </div>
    }
</div>