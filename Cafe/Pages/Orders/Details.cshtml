@page
@model Cafe.Pages.Orders.DetailsModel
@{
	ViewData["Title"] = "Информация о заказе";
}
<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Номер заказа</dt>
            <dd class="col-sm-9">@Model.Order.NumberOrder</dd>

            <dt class="col-sm-3">Счет</dt>
            <dd class="col-sm-9">@Model.Order.TotalAmount.ToString("C")</dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">@(Model.Order.Status ?? "—")</dd>
        </dl>
    </div>
</div>

<p class="mt-3">
    <a asp-page="Edit" asp-route-id="@Model.Order.Id" class="btn btn-warning">Редактировать</a>
    <a asp-page="Delete" asp-route-id="@Model.Order.Id" class="btn btn-danger">Удалить</a>
    <a asp-page="Index" class="btn btn-secondary">Назад к списку</a>
</p>