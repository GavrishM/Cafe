@page
@model Cafe.Pages.Orders.DeleteModel
@{
    ViewData["Title"] = "Удаление заказа";
}

<h1>@ViewData["Title"]</h1>

<div class="alert alert-danger">
        <h3>Вы уверены, что хотите удалить этот заказ?</h3>
</div>


<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Номер заказа</dt>
            <dd class="col-sm-9">@Model.Order.NumberOrder.ToString()</dd>

            @* <dt class="col-sm-3">Содержимое заказа</dt>
            <dd class="col-sm-9">@(Model.Order.Contains ?? "—")</dd> *@

            <dt class="col-sm-3">Счет</dt>
            <dd class="col-sm-9">@(Model.Order.TotalAmount.ToString() ?? "—")</dd>

            <dt class="col-sm-3">Статус</dt>
            <dd class="col-sm-9">@(Model.Order.Status ?? "—")</dd>

        </dl>
    </div>
</div>


<form method="post">
    <input type="hidden" asp-for="Order.Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-page="Index" class="btn btn-secondary">Отмена</a>
</form>